<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" office:version="1.2" office:mimetype="application/vnd.oasis.opendocument.text">
<office:automatic-styles><style:page-layout style:name="pm1"><style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="2.5cm" fo:margin-right="2.5cm"/></style:page-layout></office:automatic-styles>
<office:master-styles><style:master-page style:name="Standard" style:page-layout-name="pm1"><style:footer><text:p>Page <text:page-number text:select-page="current">1</text:page-number></text:p></style:footer></style:master-page></office:master-styles>
<office:body><office:text>
<text:h text:outline-level="1">Complex Title</text:h>
<text:p>Plain paragraph one that can be edited freely.</text:p>
<text:p>Has a footnote<text:note text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p>The footnote text</text:p></text:note-body></text:note> here and a <text:a xlink:href="http://example.com">web link</text:a> too.</text:p>
<text:p>Inline picture: <draw:frame draw:name="img1" text:anchor-type="as-char" svg:width="2cm" svg:height="2cm"><draw:image><office:binary-data>iVBORw0KGgoAAAANSUhEUgAAAAgAAAAICAIAAABLbSncAAAAEUlEQVR4nGM4ISeHFTEMLQkAkL9BAbKfPiIAAAAASUVORK5CYII=</office:binary-data></draw:image></draw:frame> after it.</text:p>
<text:p>Floating box anchored here<draw:frame draw:name="box1" text:anchor-type="paragraph" svg:width="5cm" svg:height="2cm" svg:x="8cm" svg:y="0.5cm"><draw:text-box><text:p>Text inside a box</text:p></draw:text-box></draw:frame> and the paragraph continues.</text:p>
<text:list><text:list-item><text:p>Bullet one</text:p></text:list-item><text:list-item><text:p>Bullet two</text:p></text:list-item></text:list>
<text:p>Date field: <text:date text:date-value="2026-01-01" style:data-style-name="">01/01/2026</text:date> end.</text:p>
<text:p>Last plain paragraph.</text:p>
</office:text></office:body></office:document>